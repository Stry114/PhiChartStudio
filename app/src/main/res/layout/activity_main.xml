<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 控制区域 -->

    <!-- 时间线视图 -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/imageButton1"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_margin="0dp"
                android:layout_weight="1"
                android:background="@null"
                app:srcCompat="@drawable/play" />

            <ImageButton
                android:id="@+id/imageButton2"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_margin="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:onClick="onNewPressed"
                app:srcCompat="@drawable/add" />

            <ImageButton
                android:id="@+id/imageButton3"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_margin="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:onClick="onDeletePressed"
                app:srcCompat="@drawable/delete" />

            <ImageButton
                android:id="@+id/imageButton4"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_margin="0dp"
                android:layout_weight="1"
                android:background="@null"
                app:srcCompat="@drawable/cut" />

            <ImageButton
                android:id="@+id/imageButton5"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_margin="0dp"
                android:layout_weight="1"
                android:background="@null"
                app:srcCompat="@drawable/copy" />

            <ImageButton
                android:id="@+id/imageButton6"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_margin="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:onClick="showPopupWindow"
                app:srcCompat="@drawable/paste" />


        </LinearLayout>


        <com.stry.phichartstudio.TrackTimelineView
            android:id="@+id/timelineView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/rightFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        </FrameLayout>
    </LinearLayout>

</LinearLayout>