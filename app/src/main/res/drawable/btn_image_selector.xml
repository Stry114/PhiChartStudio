<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按压状态：图片略微变暗（通过半透明黑色覆盖） -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- 底层：原图（确保铺满） -->
            <item android:drawable="@drawable/add" /> <!-- 替换为你的图片 -->
            <!-- 上层：半透明黑色覆盖（实现变暗效果） -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33000000" /> <!-- 黑色半透明（#33为透明度） -->
                </shape>
            </item>
        </layer-list>
    </item>

</selector>